{
    "name": "seschustle/example-comments-api-client",
    "description": "Simple API client for imaginary comments service",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "seschustle\\ExampleCommentsApiClient\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Pavel Lovkii",
            "email": "plovkiy@yandex.ru"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "php-http/discovery": "^1.15"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
